                      "description": "Begintijd, bv. 11.10"
                    },
                    "label": {
                      "type": "string",
                      "description": "Soort en nummer, bv. TechTalk 3"
                    },
                    "titel": {
                      "type": "string"
                    },
                    "omschrijving": {
                      "type": "string"
                    },
                    "pauze": {
                      "type": "boolean",
                      "description": "Grijze rij: deur open, pauze, lunch, borrel, einde"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "dataExamples": [
      {
        "name": "Alleen ochtend",
        "data": {
          "evenement": {
            "naam": "GZAC Gebruikersdag 2026",
            "datum": "dinsdag 17 november 2026",
            "locatie": "De Rode Hoed, Amsterdam"
          },
          "deelnemer": {
            "naam": "Jan Jansen",
            "organisatie": "Gemeente Voorbeeld"
          },
          "dagdelen": [
            {
              "key": "ochtend",
              "label": "Ochtend · TechTalks",
              "doelgroep": "voor ontwikkelaars, architecten en low-coders",
              "aangemeld": true,
              "sessies": [
                {
                  "tijd": "10.00",
                  "titel": "Deur open",
                  "pauze": true
                },
                {
                  "tijd": "10.30",
                  "titel": "Van Verzoek tot Archivering",
                  "pauze": false,
                  "label": "TechTalk 1",
                  "omschrijving": "In één sessie zien we hoe we vanuit Open Formulieren een verzoek maken, het zaakdossier afhandelen met GZAC en in Open Archiefbeheer archiveren. Door Joeri Bekker (Maykin)."
                },
                {
                  "tijd": "10.50",
                  "titel": "Maatwerk: je wilt het niet, maar het is wel nodig",
                  "pauze": false,
                  "label": "TechTalk 2",
                  "omschrijving": "De kern van GZAC is modelleren, niet programmeren. Hoe past maatwerk zó in GZAC dat het geen onderhoudsprobleem vormt? Maxim Buur toont het gloednieuwe Plugin Framework en vertelt over de strategie."
                },
                {
                  "tijd": "11.10",
                  "titel": "Van Data naar Document",
                  "pauze": false,
                  "label": "TechTalk 3",
                  "omschrijving": "Epistola is een gloednieuw open source component in het GZAC-ecosysteem. Sander de Groot van Epistola vertelt over documentgeneratie en geeft een live demo."
                },
                {
                  "tijd": "11.30",
                  "titel": "Pauze",
                  "pauze": true
                },
                {
                  "tijd": "12.00",
                  "titel": "Integraal Klant- en Objectbeeld: live configuratie",
                  "pauze": false,
                  "label": "TechTalk 4",
                  "omschrijving": "IKO kan een integraal klantbeeld opbouwen. Hoe koppel je IKO met GZAC, sluit je bronnen aan en toon je die data aan de gebruikers? Thomas Minke laat het live zien."
                },
                {
                  "tijd": "12.20",
                  "titel": "Bouwblokken in praktijk",
                  "pauze": false,
                  "label": "TechTalk 5",
                  "omschrijving": "In december 2025 gepresenteerd als beta, nu live in productie. Joeri Diederen van Raakvlak Advies laat in een live demo de kracht van hergebruik zien."
                },
                {
                  "tijd": "12.40",
                  "titel": "Office integratie",
                  "pauze": false,
                  "label": "TechTalk 6",
                  "omschrijving": "Samen met de gemeente Utrecht gebouwd: viewen, bewerken en opslaan van alle Microsoft-bestandstypen. Maurits van Beusekom en Thomas Luijken van Baseflow geven een live demo."
                },
                {
                  "tijd": "13.00",
                  "titel": "Lunch",
                  "pauze": true
                }
              ]
            },
            {
              "key": "middag",
              "label": "Middag · Kennissnacks",
              "doelgroep": "voor iedereen toegankelijk",
              "aangemeld": false,
              "sessies": [
                {
                  "tijd": "13.40",
                  "titel": "Opening",
                  "pauze": false,
                  "omschrijving": "Dagvoorzitter Vincent van Beek opent het middagprogramma en Anne Leguit kadert de ontwikkelingen vanuit het Platform Dienstverlening."
                },
                {
                  "tijd": "13.50",
                  "titel": "Koers van GZAC",
                  "pauze": false,
                  "label": "Kennissnack 1",
                  "omschrijving": "Rutger Haagsma deelt zijn visie op de ontwikkeling van GZAC. Nu en de komende jaren."
                },
                {
                  "tijd": "14.05",
                  "titel": "Productontwikkeling GZAC 2026",
                  "pauze": false,
                  "label": "Kennissnack 2",
                  "omschrijving": "Thomas Minke blikt terug op een jaar vol ontwikkeling binnen GZAC en laat zien wat er nog aankomt."
                },
                {
                  "tijd": "14.25",
                  "titel": "Klantcontactcentrum in Platform Dienstverlening",
                  "pauze": false,
                  "label": "Kennissnack 3",
                  "omschrijving": "Het KCC Sociaal Domein van de gemeente Den Haag verving KANA door Platform Dienstverlening. Wendy van Duijvenvoorde laat zien welke features daarvoor nodig waren."
                },
                {
                  "tijd": "14.40",
                  "titel": "Pauze",
                  "pauze": true
                },
                {
                  "tijd": "15.05",
                  "titel": "Usecase Gemeente Alkmaar: van G4 naar G50",
                  "pauze": false,
                  "label": "Kennissnack 4",
                  "omschrijving": "In 2026 nemen G50-gemeentes de stap naar open source. Sabine Kassels deelt waar zij tegenaan lopen bij aanbesteding en implementatie."
                },
                {
                  "tijd": "15.25",
                  "titel": "Paneldiscussie",
                  "pauze": false
                },
                {
                  "tijd": "15.45",
                  "titel": "GZAC en open source agentic AI",
                  "pauze": false,
                  "label": "Kennissnack 5",
                  "omschrijving": "GZAC blijkt een goede orkestrator van agents. Thomas van Maarseveen geeft een live demo van open source AI op hardware in Nederland."
                },
                {
                  "tijd": "16.00",
                  "titel": "Wrap-up door de dagvoorzitter",
                  "pauze": false
                },
                {
                  "tijd": "16.05",
                  "titel": "Borrel",
                  "pauze": true
                },
                {
                  "tijd": "17.00",
                  "titel": "Einde",
                  "pauze": true
                }
              ]
            }
          ]
        }
