              "type": "string"
            }
          }
        },
        "dagdelen": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "label", "doelgroep", "sessies"],
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "doelgroep": {
                "type": "string"
              },
              "sessies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["tijd", "titel", "pauze"],
                  "properties": {
                    "tijd": {
