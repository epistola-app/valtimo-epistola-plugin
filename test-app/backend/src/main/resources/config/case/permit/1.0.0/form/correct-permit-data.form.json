{
  "display": "form",
  "components": [
    {
      "type": "htmlelement",
      "key": "uitleg",
      "input": false,
      "tag": "p",
      "content": "Epistola kon de bevestigingsbrief niet maken. Corrigeer de gegevens van het dossier en genereer de brief opnieuw: de brief wordt weer uit het dossier opgebouwd, dus de correctie geldt ook voor latere brieven."
    },
    {
      "type": "textarea",
      "key": "pv:generationError",
      "label": "Wat Epistola weigerde",
      "input": true,
      "disabled": true,
      "autoExpand": true,
      "rows": 2
    },
    {
      "key": "applicant",
      "type": "fieldset",
      "label": "Aanvrager",
      "components": [
        {
          "key": "applicant.firstName",
          "type": "textfield",
          "input": true,
          "label": "Voornaam",
          "defaultValue": "Jan",
          "validate": {
            "required": true
          }
        },
        {
          "key": "applicant.lastName",
          "type": "textfield",
          "input": true,
          "label": "Achternaam",
          "defaultValue": "de Vries",
          "validate": {
            "required": true
          }
        },
        {
          "key": "applicant.bsn",
          "type": "textfield",
          "input": true,
          "label": "BSN",
          "defaultValue": "",
          "validate": {
            "required": false,
            "pattern": "^([0-9]{9})?$"
          }
        },
        {
          "key": "applicant.address.street",
          "type": "textfield",
          "input": true,
          "label": "Straat",
          "defaultValue": "Keizersgracht",
          "validate": {
            "required": true
          }
        },
        {
          "key": "applicant.address.houseNumber",
          "type": "textfield",
          "input": true,
          "label": "Huisnummer",
          "defaultValue": "42",
          "validate": {
            "required": true
          }
        },
        {
          "key": "applicant.address.postalCode",
          "type": "textfield",
          "input": true,
          "label": "Postcode",
          "defaultValue": "1015AB",
          "validate": {
            "required": true,
            "pattern": "^[0-9]{4}[A-Z]{2}$"
          }
        },
        {
          "key": "applicant.address.city",
          "type": "textfield",
          "input": true,
          "label": "Woonplaats",
          "defaultValue": "Amsterdam",
          "validate": {
            "required": true
          }
        }
      ]
    },
    {
      "key": "property",
      "type": "fieldset",
      "label": "Locatie",
      "components": [
        {
          "key": "property.address.street",
          "type": "textfield",
          "input": true,
          "label": "Straat",
          "defaultValue": "Herengracht",
          "validate": {
            "required": true
          }
        },
        {
          "key": "property.address.houseNumber",
          "type": "textfield",
          "input": true,
          "label": "Huisnummer",
          "defaultValue": "100",
          "validate": {
            "required": true
          }
        },
        {
          "key": "property.address.postalCode",
          "type": "textfield",
          "input": true,
          "label": "Postcode",
          "defaultValue": "1015BS",
          "validate": {
            "required": true,
            "pattern": "^[0-9]{4}[A-Z]{2}$"
          }
        },
        {
          "key": "property.address.city",
          "type": "textfield",
          "input": true,
          "label": "Woonplaats",
          "defaultValue": "Amsterdam",
          "validate": {
            "required": true
          }
        },
        {
          "key": "property.kadastraalNummer",
          "type": "textfield",
          "input": true,
          "label": "Kadastraal nummer",
          "defaultValue": "ASD01-A-1234"
        }
      ]
    },
    {
      "type": "button",
      "key": "submit",
      "label": "Opnieuw genereren",
      "input": true,
      "action": "submit",
      "disableOnInvalid": true
    }
  ]
}
