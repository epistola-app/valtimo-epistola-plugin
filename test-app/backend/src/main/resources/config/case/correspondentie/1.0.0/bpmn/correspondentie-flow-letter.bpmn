<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_flow_letter" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_EpistolaDocumentGenerated" name="EpistolaDocumentGenerated" />
  <bpmn:process id="correspondentie-flow-letter" name="Brief kiezen in een form flow" isExecutable="true">
    <bpmn:documentation>The letter composer on a form-flow step. Everything else matches the task-form demo; what this one proves is that the composer's configuration is found through a form-flow process link — the step stores its form by name, so it is resolved against the case definition rather than through a form link's id. Authorization is unchanged: a form flow is opened from a user task, which still gates the request. See docs/letter-composer.md.</bpmn:documentation>
    <bpmn:startEvent id="startEvent">
      <bpmn:outgoing>Flow_start_choose</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_choose" sourceRef="startEvent" targetRef="choose-letter-in-flow" />
    <bpmn:userTask id="choose-letter-in-flow" name="Brief kiezen (form flow)">
      <bpmn:incoming>Flow_start_choose</bpmn:incoming>
      <bpmn:outgoing>Flow_choose_generate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_choose_generate" sourceRef="choose-letter-in-flow" targetRef="generate-flow-letter" />
    <bpmn:serviceTask id="generate-flow-letter" name="Genereer gekozen brief" camunda:expression="${null}">
      <bpmn:incoming>Flow_choose_generate</bpmn:incoming>
      <bpmn:outgoing>Flow_generate_wait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="boundary-generate-error" name="EpistolaGenerationError" attachedToRef="generate-flow-letter">
      <bpmn:outgoing>Flow_boundary_err</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_gen" errorRef="Error_EpistolaDocumentError" camunda:errorCodeVariable="errorCode" camunda:errorMessageVariable="errorMessage" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_boundary_err" sourceRef="boundary-generate-error" targetRef="end-error" />
    <bpmn:endEvent id="end-error">
      <bpmn:incoming>Flow_boundary_err</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_generate_wait" sourceRef="generate-flow-letter" targetRef="wait-for-generation" />
    <bpmn:intermediateCatchEvent id="wait-for-generation" name="Wacht op document">
      <!-- Bare catch event: the plugin auto-wires the correlation token. See docs/async.md. -->
      <bpmn:incoming>Flow_generate_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_EpistolaDocumentGenerated" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_wait_end" sourceRef="wait-for-generation" targetRef="end-success" />
    <bpmn:endEvent id="end-success">
      <bpmn:incoming>Flow_wait_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:error id="Error_EpistolaDocumentError" name="EpistolaDocumentError" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="correspondentie-flow-letter">
      <bpmndi:BPMNShape id="startEvent_di" bpmnElement="startEvent">
        <dc:Bounds x="152" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="choose-letter-in-flow_di" bpmnElement="choose-letter-in-flow">
        <dc:Bounds x="240" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="generate-flow-letter_di" bpmnElement="generate-flow-letter">
        <dc:Bounds x="400" y="77" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="boundary-generate-error_di" bpmnElement="boundary-generate-error">
        <dc:Bounds x="432" y="139" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-error_di" bpmnElement="end-error">
        <dc:Bounds x="432" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait-for-generation_di" bpmnElement="wait-for-generation">
        <dc:Bounds x="562" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-success_di" bpmnElement="end-success">
        <dc:Bounds x="662" y="99" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_choose_di" bpmnElement="Flow_start_choose">
        <di:waypoint x="188" y="117" />
        <di:waypoint x="240" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_choose_generate_di" bpmnElement="Flow_choose_generate">
        <di:waypoint x="340" y="117" />
        <di:waypoint x="400" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_generate_wait_di" bpmnElement="Flow_generate_wait">
        <di:waypoint x="500" y="117" />
        <di:waypoint x="562" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_wait_end_di" bpmnElement="Flow_wait_end">
        <di:waypoint x="598" y="117" />
        <di:waypoint x="662" y="117" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_boundary_err_di" bpmnElement="Flow_boundary_err">
        <di:waypoint x="450" y="175" />
        <di:waypoint x="450" y="262" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
