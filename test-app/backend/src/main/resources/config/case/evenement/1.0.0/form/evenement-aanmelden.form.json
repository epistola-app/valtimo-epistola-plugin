{
  "display": "form",
  "components": [
    {
      "type": "htmlelement",
      "key": "intro",
      "tag": "p",
      "content": "Meld een deelnemer aan. Na het aanmelden staat de persoonlijke uitnodiging bij Documenten."
    },
    {
      "type": "textfield",
      "key": "pv:naam",
      "label": "Naam",
      "input": true,
      "validate": {
        "required": true
      }
    },
    {
      "type": "textfield",
      "key": "pv:organisatie",
      "label": "Organisatie",
      "input": true,
      "validate": {
        "required": true
      }
    },
    {
      "type": "email",
      "key": "pv:email",
      "label": "E-mail",
      "input": true,
      "validate": {
        "required": true
      }
    },
    {
      "type": "select",
      "key": "pv:dagdelen",
      "label": "Ik kom naar",
      "input": true,
      "multiple": true,
      "widget": "choicesjs",
      "dataSrc": "values",
      "data": {
        "values": [
          {
            "label": "Ochtend · TechTalks",
            "value": "ochtend"
          },
          {
            "label": "Middag · Kennissnacks",
            "value": "middag"
          }
        ]
      },
      "validate": {
        "required": true
      }
    },
    {
      "type": "epistola-document-preview",
      "key": "preview",
      "input": false,
      "label": "Voorbeeld uitnodiging",
      "previewContext": "start",
      "processDefinitionKey": "evenement-aanmelden",
      "sourceActivityId": "generate-invitation",
      "components": [
        {
          "type": "hidden",
          "key": "epistolaTaskId",
          "input": true,
          "label": "Epistola Task Id",
          "persistent": false,
          "properties": { "sourceKey": "epistola:taskId" }
        },
        {
          "type": "hidden",
          "key": "epistolaDocumentId",
          "input": true,
          "label": "Epistola Document Id",
          "persistent": false,
          "properties": { "sourceKey": "epistola:documentId" }
        }
      ]
    },
    {
      "type": "button",
      "key": "submit",
      "label": "Aanmelden",
      "action": "submit",
      "input": true,
      "disableOnInvalid": true
    }
  ]
}
